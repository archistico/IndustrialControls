<Window
    x:Class="IndustrialControls.Avalonia.Demo.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:industrial="using:IndustrialControls.Avalonia.Controls"
    Title="IndustrialControls.Avalonia — M4"
    Width="1320" Height="930" MinWidth="1020" MinHeight="720"
    Background="#1C1F21">

  <Grid RowDefinitions="Auto,*">
    <Border Padding="22,16" Background="#111315" BorderBrush="#686E72" BorderThickness="0,0,0,2">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="INDUSTRIAL CONTROLS" FontSize="25" FontWeight="Bold" Foreground="#ECEEE7" />
          <TextBlock Text="M4 · strumenti radiali, lineari, digitali e di deviazione"
                     Foreground="#A8ADA8" Margin="0,4,0,0" />
        </StackPanel>
        <industrial:EngravedLabel Grid.Column="1" Text="M4 CANDIDATE"
                                  Variant="Aluminum" ShowFasteners="True"
                                  VerticalAlignment="Center" MinWidth="170" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="24" Spacing="20">
        <industrial:IndustrialPanel Header="STRUMENTI RADIALI"
                                    Subtitle="VALORE, CAMPO OPERATIVO E SOGLIE">
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="18">
            <industrial:RadialGauge x:Name="PowerGauge" Title="GENERATOR POWER"
                                    Minimum="0" Maximum="10" Value="5"
                                    Unit="MWe" DecimalPlaces="2" ScaleDecimalPlaces="0"
                                    MajorTickCount="11" MinorTicksPerInterval="4"
                                    CautionHigh="8" WarningHigh="9.2" />
            <industrial:RadialGauge Grid.Column="1" Title="STEAM PRESSURE"
                                    Minimum="0" Maximum="8" Value="6.85"
                                    Unit="MPa" DecimalPlaces="2" ScaleDecimalPlaces="1"
                                    MajorTickCount="9" MinorTicksPerInterval="4"
                                    CautionLow="5.5" WarningLow="4.8"
                                    CautionHigh="7.2" WarningHigh="7.6" />
            <industrial:RadialGauge Grid.Column="2" Title="TURBINE SPEED"
                                    Minimum="0" Maximum="1800" Value="1500"
                                    Unit="rpm" DecimalPlaces="0" ScaleDecimalPlaces="0"
                                    MajorTickCount="7" MinorTicksPerInterval="4"
                                    CautionHigh="1560" WarningHigh="1620" />
            <industrial:RadialGauge Grid.Column="3" Title="CONDENSER VACUUM"
                                    Minimum="0" Maximum="100" Value="91"
                                    Unit="%" DecimalPlaces="1" ScaleDecimalPlaces="0"
                                    MajorTickCount="11" MinorTicksPerInterval="4"
                                    CautionLow="80" WarningLow="70" />
          </Grid>
        </industrial:IndustrialPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
          <industrial:IndustrialPanel Header="STRUMENTI LINEARI"
                                      Subtitle="LIVELLI E POSIZIONI">
            <StackPanel Spacing="16">
              <industrial:LinearGauge x:Name="LevelGauge" Title="STEAM DRUM LEVEL"
                                      Minimum="0" Maximum="100" Value="52"
                                      Unit="%" DecimalPlaces="1"
                                      CautionLow="30" WarningLow="20"
                                      CautionHigh="70" WarningHigh="80" />
              <industrial:LinearGauge x:Name="ValveGauge" Title="TURBINE CONTROL VALVE"
                                      Minimum="0" Maximum="100" Value="48"
                                      Unit="%" DecimalPlaces="1"
                                      CautionHigh="90" WarningHigh="98" />
              <industrial:LinearGauge Title="FEEDWATER FLOW"
                                      Minimum="0" Maximum="25" Value="14.2"
                                      Unit="kg/s" DecimalPlaces="1"
                                      CautionLow="8" WarningLow="5" />
            </StackPanel>
          </industrial:IndustrialPanel>

          <industrial:IndustrialPanel Grid.Column="1" Header="DIGITALI E DEVIAZIONE"
                                      Subtitle="MISURA PRINCIPALE E SCOSTAMENTO">
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <industrial:DigitalGauge x:Name="TemperatureGauge"
                                         Title="MAIN STEAM TEMPERATURE"
                                         Minimum="0" Maximum="350" Value="278.4"
                                         Unit="°C" DecimalPlaces="1"
                                         CautionHigh="310" WarningHigh="330" />
                <industrial:DigitalGauge Grid.Column="1"
                                         Title="GRID FREQUENCY"
                                         Minimum="45" Maximum="55" Value="50.02"
                                         Unit="Hz" DecimalPlaces="2"
                                         CautionLow="49.5" WarningLow="49"
                                         CautionHigh="50.5" WarningHigh="51" />
              </Grid>
              <industrial:DeviationGauge x:Name="DeviationGauge"
                                         Title="POWER SETPOINT DEVIATION"
                                         Minimum="-5" Maximum="5"
                                         Value="5" Setpoint="5"
                                         Unit="MWe" DecimalPlaces="2"
                                         CautionLow="-1" WarningLow="-2"
                                         CautionHigh="1" WarningHigh="2" />
            </StackPanel>
          </industrial:IndustrialPanel>
        </Grid>

        <industrial:IndustrialPanel Header="PROVA INTERATTIVA"
                                    Subtitle="I COMANDI MODIFICANO TUTTI GLI STRUMENTI">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="14">
            <industrial:IlluminatedPushButton Content="LOAD +" SecondaryCaption="+0.25 MWe"
                                              LampColor="Green" IsLampOn="True"
                                              Click="OnLoadRaise" />
            <industrial:IlluminatedPushButton Grid.Column="1" Content="LOAD -" SecondaryCaption="-0.25 MWe"
                                              LampColor="Amber" IsLampOn="True"
                                              Click="OnLoadLower" />
            <industrial:IlluminatedPushButton Grid.Column="2" Content="DISTURB"
                                              SecondaryCaption="PROCESS"
                                              LampColor="Red" IsLampOn="True"
                                              Click="OnDisturb" />
            <industrial:LedMatrixDisplay x:Name="StatusDisplay" Grid.Column="3"
                                         Text="UNIT STABLE - ALL PARAMETERS NORMAL"
                                         LedColor="Green" VerticalAlignment="Center" />
            <industrial:EngravedLabel Grid.Column="4" Text="NEXT: M5 CONTROLS"
                                      Variant="Red" ShowFasteners="True"
                                      VerticalAlignment="Center" />
          </Grid>
        </industrial:IndustrialPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
