<Window
    x:Class="IndustrialControls.Avalonia.Demo.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:industrial="using:IndustrialControls.Avalonia.Controls"
    Title="IndustrialControls.Avalonia — M8 RC1"
    Width="1440"
    Height="960"
    MinWidth="1120"
    MinHeight="760"
    Background="#1C1F21">

  <Grid RowDefinitions="Auto,*">
    <Border Padding="22,16"
            Background="#111315"
            BorderBrush="#686E72"
            BorderThickness="0,0,0,2">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="INDUSTRIAL CONTROLS"
                     FontSize="25"
                     FontWeight="Bold"
                     Foreground="#ECEEE7" />
          <TextBlock Text="M8 · release candidate, accessibilità, API e packaging"
                     Foreground="#A8ADA8"
                     Margin="0,4,0,0" />
        </StackPanel>

        <industrial:EngravedLabel Grid.Column="1"
                                  Text="M8 RC1"
                                  Variant="Aluminum"
                                  ShowFasteners="True"
                                  VerticalAlignment="Center"
                                  MinWidth="170" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="24" Spacing="20">
        <industrial:AlarmIndicatorPanel x:Name="AlarmPanel"
                                        Title="PRIMARY PLANT ALARM INDICATORS"
                                        Columns="3">
          <industrial:AlarmIndicatorPanel.Indicators>
          <industrial:BacklitAlarmIndicator x:Name="SteamAlarm"
                                            AlarmId="STEAM_LOW"
                                            Text="MAIN STEAM"
                                            SecondaryText="LOW PRESSURE"
                                            Priority="Warning" />

          <industrial:BacklitAlarmIndicator x:Name="VacuumAlarm"
                                            AlarmId="VACUUM_LOW"
                                            Text="CONDENSER"
                                            SecondaryText="VACUUM LOW"
                                            Priority="Critical" />

          <industrial:BacklitAlarmIndicator x:Name="PumpAlarm"
                                            AlarmId="PUMP_TRIP"
                                            Text="PRIMARY PUMP"
                                            SecondaryText="TRIP"
                                            Priority="Critical" />

          <industrial:BacklitAlarmIndicator x:Name="FeedAlarm"
                                            AlarmId="FEED_LOW"
                                            Text="FEEDWATER"
                                            SecondaryText="LOW LEVEL"
                                            Priority="Caution" />

          <industrial:BacklitAlarmIndicator x:Name="GridAlarm"
                                            AlarmId="GRID_DEVIATION"
                                            Text="GRID FREQUENCY"
                                            SecondaryText="DEVIATION"
                                            Priority="Advisory" />

          <industrial:BacklitAlarmIndicator x:Name="OilAlarm"
                                            AlarmId="OIL_PRESSURE"
                                            Text="TURBINE OIL"
                                            SecondaryText="PRESSURE LOW"
                                            Priority="Warning"
                                            IsLatched="False" />
          </industrial:AlarmIndicatorPanel.Indicators>
        </industrial:AlarmIndicatorPanel>

        <industrial:IndustrialPanel Header="PROVA CICLO ALLARMI"
                                    Subtitle="NUOVO ALLARME, ACK, RIENTRO E RESET">
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                ColumnSpacing="14">
            <industrial:IlluminatedPushButton Content="RAISE"
                                              SecondaryCaption="ALARMS"
                                              LampColor="Red"
                                              IsLampOn="True"
                                              Click="OnRaiseAlarms" />

            <industrial:IlluminatedPushButton Grid.Column="1"
                                              Content="ACK ALL"
                                              SecondaryCaption="RECOGNIZE"
                                              LampColor="Amber"
                                              IsLampOn="True"
                                              Click="OnAcknowledgeAll" />

            <industrial:IlluminatedPushButton Grid.Column="2"
                                              Content="CLEAR"
                                              SecondaryCaption="CONDITIONS"
                                              LampColor="Green"
                                              IsLampOn="True"
                                              Click="OnClearConditions" />

            <industrial:IlluminatedPushButton Grid.Column="3"
                                              Content="RESET"
                                              SecondaryCaption="LATCHED"
                                              LampColor="Blue"
                                              IsLampOn="True"
                                              Click="OnResetAll" />

            <industrial:LedMatrixDisplay Grid.Column="4"
                                         x:Name="StatusDisplay"
                                         Text="ALARM PANEL CLEAR"
                                         LedColor="Green"
                                         VerticalAlignment="Center" />

            <industrial:EngravedLabel Grid.Column="5"
                                      Text="ALARM SEQUENCE"
                                      Variant="Red"
                                      ShowFasteners="True"
                                      VerticalAlignment="Center" />
          </Grid>
        </industrial:IndustrialPanel>

        <industrial:IndustrialPanel Header="PANNELLI STATICI DI SICUREZZA"
                                    Subtitle="ICONE, COLORI E FISSAGGI A VITE">
          <Grid ColumnDefinitions="*,*,*,*"
                ColumnSpacing="16">
            <industrial:SafetyPlacard Level="Danger"
                                      Icon="ElectricalHazard"
                                      Title="DANGER"
                                      Text="HIGH VOLTAGE. ISOLATE AND VERIFY BEFORE ACCESS." />

            <industrial:SafetyPlacard Grid.Column="1"
                                      Level="Warning"
                                      Icon="HotSurface"
                                      Title="WARNING"
                                      Text="HOT SURFACE. ALLOW EQUIPMENT TO COOL BEFORE SERVICE." />

            <industrial:SafetyPlacard Grid.Column="2"
                                      Level="Caution"
                                      Icon="Radiation"
                                      Title="CAUTION"
                                      Text="CONTROLLED AREA. FOLLOW SITE ACCESS PROCEDURES." />

            <industrial:SafetyPlacard Grid.Column="3"
                                      Level="Information"
                                      Icon="Information"
                                      Title="INFORMATION"
                                      Text="REFER TO THE OPERATING MANUAL BEFORE MANUAL OVERRIDE." />
          </Grid>
        </industrial:IndustrialPanel>

        <industrial:IndustrialPanel Header="TARGHETTE DATI IMBULLONATE"
                                    Subtitle="DATI NOMINALI, IDENTIFICAZIONE E ISTRUZIONI">
          <Grid ColumnDefinitions="*,*,*"
                ColumnSpacing="18">
            <industrial:BoltedDataPlate Title="GENERATOR NAMEPLATE"
                                        Subtitle="SYNCHRONOUS UNIT"
                                        Identifier="GEN-01 / REV C"
                                        Material="Aluminum">
              <Grid ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="5">
                <TextBlock Text="RATED POWER"
                           Foreground="#17191B" />
                <TextBlock Grid.Column="1"
                           Text="10 MWe"
                           FontWeight="Bold"
                           Foreground="#17191B" />
                <TextBlock Grid.Row="1"
                           Text="RATED SPEED"
                           Foreground="#17191B" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="1500 rpm"
                           FontWeight="Bold"
                           Foreground="#17191B" />
                <TextBlock Grid.Row="2"
                           Text="FREQUENCY"
                           Foreground="#17191B" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="50 Hz"
                           FontWeight="Bold"
                           Foreground="#17191B" />
                <TextBlock Grid.Row="3"
                           Text="INSULATION"
                           Foreground="#17191B" />
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="CLASS F"
                           FontWeight="Bold"
                           Foreground="#17191B" />
              </Grid>
            </industrial:BoltedDataPlate>

            <industrial:BoltedDataPlate Grid.Column="1"
                                        Title="TURBINE GOVERNOR"
                                        Subtitle="CONTROL AUTHORITY"
                                        Identifier="GOV-CTRL-02"
                                        Material="Brass">
              <Grid ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto,Auto,Auto"
                    RowSpacing="5">
                <TextBlock Text="MODE"
                           Foreground="#201D12" />
                <TextBlock Grid.Column="1"
                           Text="SPEED / LOAD"
                           FontWeight="Bold"
                           Foreground="#201D12" />
                <TextBlock Grid.Row="1"
                           Text="DROOP"
                           Foreground="#201D12" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="1.5 rpm"
                           FontWeight="Bold"
                           Foreground="#201D12" />
                <TextBlock Grid.Row="2"
                           Text="OUTPUT"
                           Foreground="#201D12" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Text="0–100 %"
                           FontWeight="Bold"
                           Foreground="#201D12" />
                <TextBlock Grid.Row="3"
                           Text="FAIL STATE"
                           Foreground="#201D12" />
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="HOLD"
                           FontWeight="Bold"
                           Foreground="#201D12" />
              </Grid>
            </industrial:BoltedDataPlate>

            <industrial:BoltedDataPlate Grid.Column="2"
                                        Title="MANUAL OVERRIDE"
                                        Subtitle="AUTHORIZED PERSONNEL ONLY"
                                        Identifier="PROC-OVR-17"
                                        Material="Red">
              <StackPanel Spacing="7">
                <TextBlock Text="1. VERIFY ALL PERMISSIVES."
                           Foreground="#F8F2E8" />
                <TextBlock Text="2. RECORD THE OVERRIDE."
                           Foreground="#F8F2E8" />
                <TextBlock Text="3. RESTORE AUTOMATIC AUTHORITY."
                           Foreground="#F8F2E8" />
              </StackPanel>
            </industrial:BoltedDataPlate>
          </Grid>
        </industrial:IndustrialPanel>

        <industrial:IndustrialPanel Header="RELEASE CANDIDATE STATUS"
                                    Subtitle="API, ACCESSIBILITÀ, PERFORMANCE E NUGET">
          <Grid ColumnDefinitions="*,Auto"
                ColumnSpacing="18">
            <industrial:LedMatrixDisplay Text="INDUSTRIALCONTROLS.AVALONIA 1.0.0-RC.1"
                                         LedColor="Green" />
            <industrial:EngravedLabel Grid.Column="1"
                                      Text="READY FOR 1.0 GATE"
                                      Variant="Red"
                                      ShowFasteners="True"
                                      VerticalAlignment="Center" />
          </Grid>
        </industrial:IndustrialPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
