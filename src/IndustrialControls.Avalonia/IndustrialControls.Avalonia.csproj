<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IndustrialControls.Avalonia</RootNamespace>
    <AssemblyName>IndustrialControls.Avalonia</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>IndustrialControls.Avalonia</PackageId>
    <Version>1.0.0-rc.7</Version>
    <Authors>Emilie Rollandin</Authors>
    <Title>IndustrialControls.Avalonia</Title>
    <Description>Reusable Avalonia controls inspired by 1990s industrial control panels.</Description>
    <PackageReleaseNotes>Seventh 1.0 release candidate: binding-safe value coercion, reactive alarm-panel counters, stable alarm blinking, cursor-readout invalidation, accessibility fallback updates, and fail-fast validation scripts.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <PackageTags>avalonia;controls;industrial;hmi;gauge;led;operator;switch;slider;trend;oscilloscope;recorder;alarm;annunciator;placard;nameplate</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" Link="CHANGELOG.md" />
    <None Include="..\..\docs\PACKAGE_USAGE.md" Pack="true" PackagePath="docs\" Link="PACKAGE_USAGE.md" />
    <None Include="..\..\docs\PUBLIC_API.md" Pack="true" PackagePath="docs\" Link="PUBLIC_API.md" />
    <None Include="..\..\docs\ACCESSIBILITY.md" Pack="true" PackagePath="docs\" Link="ACCESSIBILITY.md" />
    <None Include="..\..\docs\DEMO_CATALOG.md" Pack="true" PackagePath="docs\" Link="DEMO_CATALOG.md" />
  </ItemGroup>
</Project>
