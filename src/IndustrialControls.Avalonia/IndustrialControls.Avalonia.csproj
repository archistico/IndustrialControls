<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>IndustrialControls.Avalonia</RootNamespace>
    <AssemblyName>IndustrialControls.Avalonia</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
    <PackageId>IndustrialControls.Avalonia</PackageId>
    <Version>1.0.0</Version>
    <Authors>Emilie Rollandin</Authors>
    <Title>IndustrialControls.Avalonia</Title>
    <Description>Reusable Avalonia controls inspired by 1990s industrial control panels.</Description>
    <PackageReleaseNotes>IndustrialControls.Avalonia 1.0.0: stable reusable Avalonia industrial-control library with Industrial90 theme, lamps and LED displays, gauges, operator controls, trends and screens, alarm indicators, static panel elements, accessibility metadata, bounded time-series buffers, performance diagnostics, and validated NuGet package consumption.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <PackageTags>avalonia;controls;industrial;hmi;gauge;led;operator;switch;slider;trend;oscilloscope;recorder;alarm;annunciator;placard;nameplate</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" Link="CHANGELOG.md" />
    <None Include="..\..\docs\PACKAGE_USAGE.md" Pack="true" PackagePath="docs\" Link="PACKAGE_USAGE.md" />
    <None Include="..\..\docs\PUBLIC_API.md" Pack="true" PackagePath="docs\" Link="PUBLIC_API.md" />
    <None Include="..\..\docs\ACCESSIBILITY.md" Pack="true" PackagePath="docs\" Link="ACCESSIBILITY.md" />
    <None Include="..\..\docs\DEMO_CATALOG.md" Pack="true" PackagePath="docs\" Link="DEMO_CATALOG.md" />
    <None Include="..\..\docs\CONTROL_CATALOG.md" Pack="true" PackagePath="docs\" Link="CONTROL_CATALOG.md" />
    <None Include="..\..\docs\PERFORMANCE.md" Pack="true" PackagePath="docs\" Link="PERFORMANCE.md" />
    <None Include="..\..\docs\RELEASE_CHECKLIST.md" Pack="true" PackagePath="docs\" Link="RELEASE_CHECKLIST.md" />
    <None Include="..\..\screenshot\01-foundation.png" Pack="true" PackagePath="screenshot\" Link="01-foundation.png" />
    <None Include="..\..\screenshot\02-lamps-and-led.png" Pack="true" PackagePath="screenshot\" Link="02-lamps-and-led.png" />
    <None Include="..\..\screenshot\03-gauges.png" Pack="true" PackagePath="screenshot\" Link="03-gauges.png" />
    <None Include="..\..\screenshot\04-operator-controls.png" Pack="true" PackagePath="screenshot\" Link="04-operator-controls.png" />
    <None Include="..\..\screenshot\05-trends-and-screens.png" Pack="true" PackagePath="screenshot\" Link="05-trends-and-screens.png" />
    <None Include="..\..\screenshot\06-alarm-indicators.png" Pack="true" PackagePath="screenshot\" Link="06-alarm-indicators.png" />
    <None Include="..\..\screenshot\07-static-and-release.png" Pack="true" PackagePath="screenshot\" Link="07-static-and-release.png" />
  </ItemGroup>
</Project>
