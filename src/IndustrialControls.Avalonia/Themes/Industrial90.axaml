<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IndustrialControls.Avalonia.Controls">

  <Styles.Resources>
    <FocusAdornerTemplate x:Key="Industrial90.FocusAdorner">
      <Border Margin="-3"
              BorderBrush="#F1F1DF"
              BorderThickness="2"
              CornerRadius="4"
              IsHitTestVisible="False" />
    </FocusAdornerTemplate>
<Color x:Key="Industrial90.PanelDarkColor">#292C2F</Color>
    <Color x:Key="Industrial90.PanelColor">#454A4E</Color>
    <Color x:Key="Industrial90.PanelLightColor">#686E72</Color>
    <Color x:Key="Industrial90.RecessColor">#111416</Color>
    <Color x:Key="Industrial90.EdgeLightColor">#969DA1</Color>
    <Color x:Key="Industrial90.EdgeDarkColor">#17191B</Color>
    <Color x:Key="Industrial90.TextColor">#E5E7DE</Color>
    <Color x:Key="Industrial90.MutedTextColor">#A8ADA8</Color>
    <Color x:Key="Industrial90.LabelBlackColor">#121313</Color>
    <Color x:Key="Industrial90.LabelRedColor">#6F1616</Color>
    <Color x:Key="Industrial90.LabelAluminumColor">#A8ADB0</Color>
    <Color x:Key="Industrial90.ScrewColor">#858B8E</Color>
    <Color x:Key="Industrial90.GlassColor">#2A091018</Color>

    <SolidColorBrush x:Key="Industrial90.PanelDarkBrush" Color="{StaticResource Industrial90.PanelDarkColor}" />
    <SolidColorBrush x:Key="Industrial90.PanelBrush" Color="{StaticResource Industrial90.PanelColor}" />
    <SolidColorBrush x:Key="Industrial90.PanelLightBrush" Color="{StaticResource Industrial90.PanelLightColor}" />
    <SolidColorBrush x:Key="Industrial90.RecessBrush" Color="{StaticResource Industrial90.RecessColor}" />
    <SolidColorBrush x:Key="Industrial90.EdgeLightBrush" Color="{StaticResource Industrial90.EdgeLightColor}" />
    <SolidColorBrush x:Key="Industrial90.EdgeDarkBrush" Color="{StaticResource Industrial90.EdgeDarkColor}" />
    <SolidColorBrush x:Key="Industrial90.TextBrush" Color="{StaticResource Industrial90.TextColor}" />
    <SolidColorBrush x:Key="Industrial90.MutedTextBrush" Color="{StaticResource Industrial90.MutedTextColor}" />
    <SolidColorBrush x:Key="Industrial90.LabelBlackBrush" Color="{StaticResource Industrial90.LabelBlackColor}" />
    <SolidColorBrush x:Key="Industrial90.LabelRedBrush" Color="{StaticResource Industrial90.LabelRedColor}" />
    <SolidColorBrush x:Key="Industrial90.LabelAluminumBrush" Color="{StaticResource Industrial90.LabelAluminumColor}" />
    <SolidColorBrush x:Key="Industrial90.ScrewBrush" Color="{StaticResource Industrial90.ScrewColor}" />
    <SolidColorBrush x:Key="Industrial90.GlassBrush" Color="{StaticResource Industrial90.GlassColor}" />

<ControlTheme x:Key="{x:Type controls:IndustrialPanel}" TargetType="controls:IndustrialPanel">
    <Setter Property="Foreground" Value="{DynamicResource Industrial90.TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource Industrial90.PanelBrush}" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
                BorderThickness="2"
                CornerRadius="4">
          <Border Margin="2"
                  BorderBrush="{DynamicResource Industrial90.EdgeLightBrush}"
                  BorderThickness="1"
                  CornerRadius="2">
            <Grid RowDefinitions="Auto,*">
              <Border Padding="14,9"
                      Background="{DynamicResource Industrial90.PanelDarkBrush}"
                      BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
                      BorderThickness="0,0,0,2">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <ContentPresenter Content="{TemplateBinding Header}"
                                      FontSize="15"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource Industrial90.TextBrush}" />
                    <TextBlock Text="{TemplateBinding Subtitle}"
                               FontSize="11"
                               Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="6"
                              IsVisible="{TemplateBinding ShowFasteners}">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Industrial90.ScrewBrush}" />
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Industrial90.ScrewBrush}" />
                  </StackPanel>
                </Grid>
              </Border>
              <ContentPresenter Grid.Row="1"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Grid>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

<ControlTheme x:Key="{x:Type controls:InstrumentBezel}" TargetType="controls:InstrumentBezel">
    <Setter Property="Foreground" Value="{DynamicResource Industrial90.TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource Industrial90.RecessBrush}" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="7">
          <TextBlock Text="{TemplateBinding Title}"
                     HorizontalAlignment="Center"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource Industrial90.TextBrush}" />
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
                  BorderThickness="4"
                  CornerRadius="5"
                  MinHeight="72">
            <Border Margin="2"
                    Padding="{TemplateBinding Padding}"
                    BorderBrush="{DynamicResource Industrial90.EdgeLightBrush}"
                    BorderThickness="1"
                    CornerRadius="2">
              <Grid>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                <Border Background="{DynamicResource Industrial90.GlassBrush}"
                        IsHitTestVisible="False"
                        IsVisible="{TemplateBinding ShowGlass}" />
              </Grid>
            </Border>
          </Border>
          <TextBlock Text="{TemplateBinding Unit}"
                     HorizontalAlignment="Center"
                     FontSize="11"
                     Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

<ControlTheme x:Key="{x:Type controls:EngravedLabel}" TargetType="controls:EngravedLabel">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="MinWidth" Value="90" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{DynamicResource Industrial90.LabelBlackBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
                BorderThickness="2"
                CornerRadius="2"
                Padding="12,5">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Ellipse Width="6"
                     Height="6"
                     Fill="{DynamicResource Industrial90.ScrewBrush}"
                     VerticalAlignment="Center"
                     IsVisible="{TemplateBinding ShowFasteners}" />
            <TextBlock Grid.Column="1"
                       Text="{TemplateBinding Text}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="{TemplateBinding Foreground}" />
            <Ellipse Grid.Column="2"
                     Width="6"
                     Height="6"
                     Fill="{DynamicResource Industrial90.ScrewBrush}"
                     VerticalAlignment="Center"
                     IsVisible="{TemplateBinding ShowFasteners}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

<ControlTheme x:Key="{x:Type controls:IndustrialLamp}" TargetType="controls:IndustrialLamp">
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Spacing="7">
          <Border Padding="4"
                  Background="{DynamicResource Industrial90.PanelDarkBrush}"
                  BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
                  BorderThickness="2"
                  CornerRadius="{TemplateBinding LampCornerRadius}">
            <Border Background="{TemplateBinding InactiveBrush}"
                    BorderBrush="{DynamicResource Industrial90.EdgeLightBrush}"
                    BorderThickness="1"
                    CornerRadius="{TemplateBinding LampCornerRadius}">
              <Border Margin="3"
                      MinWidth="24"
                      MinHeight="24"
                      Background="{TemplateBinding ActiveBrush}"
                      Opacity="{TemplateBinding EffectiveOpacity}"
                      CornerRadius="{TemplateBinding LampCornerRadius}" />
            </Border>
          </Border>
          <TextBlock Text="{TemplateBinding Label}"
                     IsVisible="{TemplateBinding ShowLabel}"
                     HorizontalAlignment="Center"
                     FontSize="10"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Industrial90.TextBrush}" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

<ControlTheme x:Key="{x:Type controls:IlluminatedPushButton}" TargetType="controls:IlluminatedPushButton">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusAdorner" Value="{StaticResource Industrial90.FocusAdorner}" />
    <Setter Property="MinWidth" Value="132" />
    <Setter Property="MinHeight" Value="150" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Background" Value="{DynamicResource Industrial90.PanelBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Industrial90.EdgeDarkBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4"
                Padding="{TemplateBinding Padding}">
          <Border BorderBrush="{DynamicResource Industrial90.EdgeLightBrush}"
                  BorderThickness="1"
                  CornerRadius="2"
                  Padding="10">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  RowSpacing="6">
              <controls:IndustrialLamp Grid.Row="0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Width="52"
                                       Height="52"
                                       Shape="Round"
                                       ShowLabel="False"
                                       IsOn="{TemplateBinding IsLampOn}"
                                       LampColor="{TemplateBinding LampColor}"
                                       State="{TemplateBinding LampState}" />

              <ContentPresenter Grid.Row="1"
                                Content="{TemplateBinding Content}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{TemplateBinding CaptionForeground}" />

              <TextBlock Grid.Row="2"
                         Text="{TemplateBinding SecondaryCaption}"
                         HorizontalAlignment="Center"
                         TextAlignment="Center"
                         FontSize="9"
                         Foreground="{DynamicResource Industrial90.MutedTextBrush}" />

              <TextBlock Grid.Row="3"
                         Text="{TemplateBinding StatusText}"
                         IsVisible="{TemplateBinding IsInterlocked}"
                         HorizontalAlignment="Center"
                         TextAlignment="Center"
                         TextWrapping="Wrap"
                         FontSize="8"
                         FontWeight="Bold"
                         Foreground="{TemplateBinding StatusBrush}" />
            </Grid>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
  
<ControlTheme x:Key="{x:Type controls:LedMatrixDisplay}" TargetType="controls:LedMatrixDisplay">
  <Setter Property="MinHeight" Value="54" />
  <Setter Property="Padding" Value="12,9" />
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="#080B09" BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
              BorderThickness="4" CornerRadius="3" Padding="{TemplateBinding Padding}">
        <Border BorderBrush="{DynamicResource Industrial90.EdgeLightBrush}" BorderThickness="1"
                Background="#101713" Padding="8,5">
          <TextBlock Text="{TemplateBinding Text}" FontFamily="Cascadia Mono,Consolas,monospace"
                     FontSize="22" FontWeight="Bold" LetterSpacing="2"
                     Foreground="{TemplateBinding LedBrush}" Opacity="{TemplateBinding EffectiveOpacity}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
      </Border>
    </ControlTemplate>
  </Setter>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:LedMarqueeDisplay}" TargetType="controls:LedMarqueeDisplay"
              BasedOn="{StaticResource {x:Type controls:LedMatrixDisplay}}">
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="#080B09"
              BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
              BorderThickness="4"
              CornerRadius="3"
              Padding="{TemplateBinding Padding}">
        <Border BorderBrush="{DynamicResource Industrial90.EdgeLightBrush}"
                BorderThickness="1"
                Background="#101713"
                Padding="8,5"
                ClipToBounds="True">
          <TextBlock Text="{TemplateBinding DisplayText}"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     FontSize="22"
                     FontWeight="Bold"
                     LetterSpacing="2"
                     Foreground="{TemplateBinding LedBrush}"
                     Opacity="{TemplateBinding EffectiveOpacity}"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Center"
                     TextWrapping="NoWrap"
                     TextTrimming="None" />
        </Border>
      </Border>
    </ControlTemplate>
  </Setter>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:SevenSegmentDisplay}" TargetType="controls:SevenSegmentDisplay"
              BasedOn="{StaticResource {x:Type controls:LedMatrixDisplay}}">
  <Setter Property="MinHeight" Value="68" />
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="#060806" BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
              BorderThickness="5" CornerRadius="3" Padding="14,8">
        <TextBlock Text="{TemplateBinding Text}" FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="32" FontWeight="Bold" LetterSpacing="3"
                   Foreground="{TemplateBinding LedBrush}" Opacity="{TemplateBinding EffectiveOpacity}"
                   HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Border>
    </ControlTemplate>
  </Setter>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:AlarmAnnunciator}" TargetType="controls:AlarmAnnunciator">
  <Setter Property="MinWidth" Value="205" />
  <Setter Property="MinHeight" Value="74" />
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="#171A1C"
              BorderBrush="#090B0C"
              BorderThickness="3"
              CornerRadius="3"
              Padding="4">
        <Border Background="#292D30"
                BorderBrush="#777E82"
                BorderThickness="1"
                CornerRadius="2">
          <Grid ColumnDefinitions="6,*,Auto">
            <Border Background="{TemplateBinding PriorityBrush}"
                    Opacity="0.90" />

            <Grid Grid.Column="1"
                  Margin="10,7"
                  RowDefinitions="*,Auto">
              <TextBlock Text="{TemplateBinding Text}"
                         FontSize="12"
                         FontWeight="Bold"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         Foreground="#ECEEE7" />

              <TextBlock Grid.Row="1"
                         Text="{TemplateBinding StateText}"
                         Margin="0,4,0,0"
                         FontSize="8"
                         FontWeight="Bold"
                         Foreground="#AAB0B2" />
            </Grid>

            <Grid Grid.Column="2"
                  Width="34"
                  Height="34"
                  Margin="6,0,10,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
              <Ellipse Fill="#0C0F10"
                       Stroke="#858C90"
                       StrokeThickness="2" />

              <Ellipse Margin="6"
                       Fill="{TemplateBinding PriorityBrush}"
                       Opacity="{TemplateBinding LampOpacity}"
                       Stroke="#0B0D0E"
                       StrokeThickness="1" />
            </Grid>
          </Grid>
        </Border>
      </Border>
    </ControlTemplate>
  </Setter>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:AlarmAnnunciatorPanel}" TargetType="controls:AlarmAnnunciatorPanel">
  <Setter Property="ItemsPanel">
    <ItemsPanelTemplate>
      <WrapPanel Orientation="Horizontal"
                 ItemWidth="230"
                 ItemHeight="82" />
    </ItemsPanelTemplate>
  </Setter>
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="#202427"
              BorderBrush="#090B0C"
              BorderThickness="4"
              CornerRadius="3"
              Padding="10">
        <Border BorderBrush="#6F767A"
                BorderThickness="1"
                Padding="8">
          <ItemsPresenter />
        </Border>
      </Border>
    </ControlTemplate>
  </Setter>
</ControlTheme>

  
<ControlTheme x:Key="{x:Type controls:RadialGauge}" TargetType="controls:RadialGauge">
  <Setter Property="MinWidth" Value="220" />
  <Setter Property="MinHeight" Value="272" />
  <Setter Property="Template">
    <ControlTemplate>
      <StackPanel Spacing="5">
        <TextBlock Text="{TemplateBinding Title}" HorizontalAlignment="Center"
                   FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource Industrial90.TextBrush}" />
        <controls:RadialGaugeDial Width="210" Height="210" HorizontalAlignment="Center"
                                  Minimum="{TemplateBinding Minimum}"
                                  Maximum="{TemplateBinding Maximum}"
                                  Value="{TemplateBinding Value}"
                                  StartAngle="{TemplateBinding StartAngle}"
                                  SweepAngle="{TemplateBinding SweepAngle}"
                                  MajorTickCount="{TemplateBinding MajorTickCount}"
                                  MinorTicksPerInterval="{TemplateBinding MinorTicksPerInterval}"
                                  ScaleDecimalPlaces="{TemplateBinding ScaleDecimalPlaces}"
                                  ShowScaleLabels="{TemplateBinding ShowScaleLabels}"
                                  ShowOperatingBands="{TemplateBinding ShowOperatingBands}"
                                  CautionLow="{TemplateBinding CautionLow}"
                                  CautionHigh="{TemplateBinding CautionHigh}"
                                  WarningLow="{TemplateBinding WarningLow}"
                                  WarningHigh="{TemplateBinding WarningHigh}"
                                  NeedleBrush="{TemplateBinding StatusBrush}" />
        <StackPanel HorizontalAlignment="Center" Margin="0,-64,0,8">
          <TextBlock Text="{TemplateBinding FormattedValue}"
                     HorizontalAlignment="Center" FontSize="18" FontWeight="Bold"
                     Foreground="{TemplateBinding StatusBrush}" />
          <TextBlock Text="{TemplateBinding Status}"
                     HorizontalAlignment="Center" FontSize="9"
                     Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
        </StackPanel>
      </StackPanel>
    </ControlTemplate>
  </Setter>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:LinearGauge}" TargetType="controls:LinearGauge">
  <Setter Property="MinWidth" Value="220" />
  <Setter Property="MinHeight" Value="84" />
  <Setter Property="Template">
    <ControlTemplate>
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{TemplateBinding Title}" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource Industrial90.TextBrush}" />
          <TextBlock Grid.Column="1" Text="{TemplateBinding FormattedValue}"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     FontWeight="Bold" Foreground="{TemplateBinding StatusBrush}" />
        </Grid>
        <Border Background="#111415" BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
                BorderThickness="3" Padding="4">
          <ProgressBar Minimum="0" Maximum="100" Value="{TemplateBinding Percentage}"
                       Height="22" Foreground="{TemplateBinding StatusBrush}"
                       Background="#252A2C" />
        </Border>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="{TemplateBinding Minimum}" FontSize="9"
                     Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
          <TextBlock Grid.Column="2" Text="{TemplateBinding Maximum}" FontSize="9"
                     Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
        </Grid>
      </StackPanel>
    </ControlTemplate>
  </Setter>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:DigitalGauge}" TargetType="controls:DigitalGauge">
  <Setter Property="MinWidth" Value="210" />
  <Setter Property="MinHeight" Value="100" />
  <Setter Property="Template">
    <ControlTemplate>
      <StackPanel Spacing="6">
        <TextBlock Text="{TemplateBinding Title}" FontSize="11" FontWeight="Bold"
                   Foreground="{DynamicResource Industrial90.TextBrush}" />
        <Border Background="#060806" BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
                BorderThickness="5" CornerRadius="3" Padding="14,10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{TemplateBinding FormattedValue}"
                       FontFamily="Cascadia Mono,Consolas,monospace"
                       FontSize="27" FontWeight="Bold" LetterSpacing="2"
                       Foreground="{TemplateBinding StatusBrush}" />
            <TextBlock Grid.Column="1" Text="{TemplateBinding Status}"
                       VerticalAlignment="Bottom" FontSize="9"
                       Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
          </Grid>
        </Border>
      </StackPanel>
    </ControlTemplate>
  </Setter>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:DeviationGauge}" TargetType="controls:DeviationGauge">
  <Setter Property="MinWidth" Value="260" />
  <Setter Property="MinHeight" Value="110" />
  <Setter Property="Template">
    <ControlTemplate>
      <StackPanel Spacing="7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{TemplateBinding Title}" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource Industrial90.TextBrush}" />
          <TextBlock Grid.Column="1" Text="{TemplateBinding FormattedDeviation}"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     FontWeight="Bold" Foreground="{TemplateBinding StatusBrush}" />
        </Grid>
        <Border Background="#111415" BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
                BorderThickness="3" Padding="4">
          <Grid>
            <ProgressBar Minimum="0" Maximum="100" Value="{TemplateBinding Percentage}"
                         Height="24" Foreground="{TemplateBinding StatusBrush}"
                         Background="#252A2C" />
            <Border Width="2" Background="#F1F1DF" HorizontalAlignment="Center" />
          </Grid>
        </Border>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="NEG" FontSize="9" Foreground="#A8ADA8" />
          <TextBlock Grid.Column="1" Text="SETPOINT" HorizontalAlignment="Center"
                     FontSize="9" Foreground="#A8ADA8" />
          <TextBlock Grid.Column="2" Text="POS" FontSize="9" Foreground="#A8ADA8" />
        </Grid>
      </StackPanel>
    </ControlTemplate>
  </Setter>
</ControlTheme>

  
<ControlTheme x:Key="IndustrialSliderRepeatTrackTheme" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False" />
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="{TemplateBinding Background}" CornerRadius="2" />
    </ControlTemplate>
  </Setter>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:IndustrialSlider}" TargetType="controls:IndustrialSlider">
    <Setter Property="Focusable" Value="True" />
  <Setter Property="FocusAdorner" Value="{StaticResource Industrial90.FocusAdorner}" />
<Setter Property="MinWidth" Value="300" />
  <Setter Property="MinHeight" Value="116" />
  <Setter Property="Template">
    <ControlTemplate>
      <Grid x:Name="SliderRoot" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="7">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{TemplateBinding Title}" FontSize="11" FontWeight="Bold"
                     Foreground="{DynamicResource Industrial90.TextBrush}" />
          <TextBlock Grid.Column="1" Text="{TemplateBinding FormattedValue}"
                     FontFamily="Cascadia Mono,Consolas,monospace"
                     FontSize="15" FontWeight="Bold" Foreground="#58D46C" />
        </Grid>

        <Border Grid.Row="1" Background="#111415"
                BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
                BorderThickness="4" Padding="5" CornerRadius="3">
          <Grid Height="34">
            <Border x:Name="TrackBackground" Height="12"
                    Margin="12,0" VerticalAlignment="Center"
                    Background="#252A2C"
                    BorderBrush="{DynamicResource Industrial90.EdgeLightBrush}"
                    BorderThickness="1" CornerRadius="2" />
            <Track x:Name="PART_Track"
                   Margin="12,0"
                   Orientation="Horizontal"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <Track.DecreaseButton>
                <RepeatButton x:Name="PART_DecreaseButton"
                              Background="#3E9B50"
                              Theme="{StaticResource IndustrialSliderRepeatTrackTheme}" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton x:Name="PART_IncreaseButton"
                              Background="Transparent"
                              Theme="{StaticResource IndustrialSliderRepeatTrackTheme}" />
              </Track.IncreaseButton>
              <Track.Thumb>
                <Thumb x:Name="thumb" Width="24" Height="34">
                  <Thumb.Template>
                    <ControlTemplate>
                      <Border Background="#B8BDC0"
                              BorderBrush="#111315"
                              BorderThickness="3"
                              CornerRadius="3">
                        <Border Margin="4"
                                BorderBrush="#737A7E"
                                BorderThickness="1" />
                      </Border>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
          <TextBlock Text="{TemplateBinding Minimum}" FontSize="9"
                     Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
          <TextBlock Grid.Column="2" Text="{TemplateBinding Maximum}" FontSize="9"
                     Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
        </Grid>

        <TextBlock x:Name="InterlockStatusText"
                   Grid.Row="3"
                   Text="{TemplateBinding InterlockText}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   FontSize="9"
                   Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
      </Grid>
    </ControlTemplate>
  </Setter>

  <Style Selector="^ /template/ Track#PART_Track">
    <Setter Property="Minimum" Value="{TemplateBinding Minimum}" />
    <Setter Property="Maximum" Value="{TemplateBinding Maximum}" />
    <Setter Property="Value" Value="{TemplateBinding Value, Mode=TwoWay}" />
  </Style>

  <Style Selector="^:disabled /template/ Grid#SliderRoot">
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <Style Selector="^:interlocked /template/ Grid#SliderRoot">
    <Setter Property="Opacity" Value="0.78" />
  </Style>

  <Style Selector="^:interlocked /template/ TextBlock#InterlockStatusText">
    <Setter Property="Foreground" Value="#F2DD4B" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:RotaryKnob}" TargetType="controls:RotaryKnob">
      <Setter Property="Cursor" Value="Hand" />
<Setter Property="Focusable" Value="True" />
  <Setter Property="FocusAdorner" Value="{StaticResource Industrial90.FocusAdorner}" />
<Setter Property="MinWidth" Value="230" />
  <Setter Property="MinHeight" Value="315" />
  <Setter Property="Template">
    <ControlTemplate>
      <StackPanel Spacing="6">
        <TextBlock Text="{TemplateBinding Title}" HorizontalAlignment="Center"
                   FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource Industrial90.TextBrush}" />
        <controls:RotaryKnobDial Width="190" Height="190"
                                 HorizontalAlignment="Center"
                                 IndicatorAngle="{TemplateBinding IndicatorAngle}"
                                 TickCount="{TemplateBinding TickCount}"
                                 IsInterlocked="{TemplateBinding IsInterlocked}" />
        <TextBlock Text="{TemplateBinding FormattedValue}"
                   HorizontalAlignment="Center" Margin="0,4,0,0"
                   FontFamily="Cascadia Mono,Consolas,monospace"
                   FontSize="19" FontWeight="Bold" Foreground="#58D46C" />
        <TextBlock x:Name="InterlockStatusText" Text="{TemplateBinding StatusText}"
                   HorizontalAlignment="Center" FontSize="9"
                   Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
      </StackPanel>
    </ControlTemplate>
  </Setter>

  <Style Selector="^:interlocked">
    <Setter Property="Opacity" Value="0.78" />
  </Style>

  <Style Selector="^:interlocked /template/ TextBlock#InterlockStatusText">
    <Setter Property="Foreground" Value="#F2DD4B" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:SelectorSwitch}" TargetType="controls:SelectorSwitch">
      <Setter Property="Cursor" Value="Hand" />
<Setter Property="Focusable" Value="True" />
  <Setter Property="FocusAdorner" Value="{StaticResource Industrial90.FocusAdorner}" />
<Setter Property="MinWidth" Value="260" />
  <Setter Property="MinHeight" Value="326" />
  <Setter Property="Template">
    <ControlTemplate>
      <StackPanel Spacing="6">
        <TextBlock Text="{TemplateBinding Title}" HorizontalAlignment="Center"
                   FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource Industrial90.TextBrush}" />
        <controls:SelectorSwitchDial Width="250" Height="210"
                                     HorizontalAlignment="Center"
                                     PositionCount="{TemplateBinding PositionCount}"
                                     Position="{TemplateBinding Position}"
                                     PositionLabels="{TemplateBinding PositionLabels}"
                                     IsInterlocked="{TemplateBinding IsInterlocked}" />
        <TextBlock Text="{TemplateBinding SelectedLabel}"
                   HorizontalAlignment="Center" Margin="0,16,0,0"
                   FontSize="17" FontWeight="Bold" Foreground="#F1F1DF" />
        <TextBlock x:Name="InterlockStatusText" Text="{TemplateBinding StatusText}"
                   HorizontalAlignment="Center" FontSize="9"
                   Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
      </StackPanel>
    </ControlTemplate>
  </Setter>

  <Style Selector="^:interlocked">
    <Setter Property="Opacity" Value="0.78" />
  </Style>

  <Style Selector="^:interlocked /template/ TextBlock#InterlockStatusText">
    <Setter Property="Foreground" Value="#F2DD4B" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:IndustrialToggleSwitch}"
              TargetType="controls:IndustrialToggleSwitch">
      <Setter Property="Cursor" Value="Hand" />
<Setter Property="Focusable" Value="True" />
  <Setter Property="FocusAdorner" Value="{StaticResource Industrial90.FocusAdorner}" />
<Setter Property="MinWidth" Value="230" />
  <Setter Property="MinHeight" Value="310" />
  <Setter Property="Background" Value="Transparent" />
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="{TemplateBinding Background}" Padding="6">
        <StackPanel Spacing="8">
          <TextBlock Text="{TemplateBinding Title}" HorizontalAlignment="Center"
                     FontSize="12" FontWeight="Bold"
                     Foreground="{DynamicResource Industrial90.TextBrush}" />
          <Grid Width="180" Height="175" HorizontalAlignment="Center">
            <TextBlock Text="{TemplateBinding OnCaption}"
                       HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0,2,0,0"
                       FontSize="10" FontWeight="Bold" Foreground="#58D46C" />
            <TextBlock Text="{TemplateBinding OffCaption}"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,2"
                       FontSize="10" FontWeight="Bold" Foreground="#F14C4C" />
            <controls:ToggleSwitchDial Width="150" Height="150"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsOn="{TemplateBinding IsOn}"
                                       IsInterlocked="{TemplateBinding IsInterlocked}" />
          </Grid>
          <TextBlock Text="{TemplateBinding StateText}"
                     HorizontalAlignment="Center" Margin="0,4,0,0"
                     FontSize="17" FontWeight="Bold" Foreground="#F1F1DF" />
          <TextBlock x:Name="InterlockStatusText" Text="{TemplateBinding StatusText}"
                     HorizontalAlignment="Center" FontSize="9"
                     Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
        </StackPanel>
      </Border>
    </ControlTemplate>
  </Setter>

  <Style Selector="^:interlocked">
    <Setter Property="Opacity" Value="0.78" />
  </Style>

  <Style Selector="^:interlocked /template/ TextBlock#InterlockStatusText">
    <Setter Property="Foreground" Value="#F2DD4B" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:SpringReturnSwitch}"
              TargetType="controls:SpringReturnSwitch">
      <Setter Property="Cursor" Value="Hand" />
<Setter Property="Focusable" Value="True" />
  <Setter Property="FocusAdorner" Value="{StaticResource Industrial90.FocusAdorner}" />
<Setter Property="MinWidth" Value="280" />
  <Setter Property="MinHeight" Value="326" />
  <Setter Property="Template">
    <ControlTemplate>
      <StackPanel Spacing="6">
        <TextBlock Text="{TemplateBinding Title}" HorizontalAlignment="Center"
                   FontSize="12" FontWeight="Bold"
                   Foreground="{DynamicResource Industrial90.TextBrush}" />
        <controls:SelectorSwitchDial Width="250" Height="210"
                                     HorizontalAlignment="Center"
                                     PositionCount="3"
                                     Position="{TemplateBinding PositionIndex}"
                                     PositionLabels="{TemplateBinding PositionLabels}"
                                     IsInterlocked="{TemplateBinding IsInterlocked}" />
        <TextBlock Text="{TemplateBinding StateText}"
                   HorizontalAlignment="Center" Margin="0,16,0,0"
                   FontSize="17" FontWeight="Bold" Foreground="#F1F1DF" />
        <TextBlock x:Name="InterlockStatusText" Text="{TemplateBinding StatusText}"
                   HorizontalAlignment="Center" FontSize="9"
                   Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
      </StackPanel>
    </ControlTemplate>
  </Setter>

  <Style Selector="^:interlocked">
    <Setter Property="Opacity" Value="0.78" />
  </Style>

  <Style Selector="^:interlocked /template/ TextBlock#InterlockStatusText">
    <Setter Property="Foreground" Value="#F2DD4B" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:InterlockIndicator}"
              TargetType="controls:InterlockIndicator">
  <Setter Property="MinWidth" Value="330" />
  <Setter Property="MinHeight" Value="150" />
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="#191C1E"
              BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
              BorderThickness="4" CornerRadius="4" Padding="14">
        <Border BorderBrush="{DynamicResource Industrial90.EdgeLightBrush}"
                BorderThickness="1" Padding="12">
          <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="14" RowSpacing="5">
            <controls:IndustrialLamp Grid.RowSpan="3"
                                     Width="52" Height="52"
                                     VerticalAlignment="Center"
                                     ShowLabel="False"
                                     Shape="Round"
                                     IsOn="True"
                                     LampColor="{TemplateBinding LampColor}" />

            <TextBlock Grid.Column="1" Text="{TemplateBinding Title}"
                       FontSize="12" FontWeight="Bold"
                       Foreground="{DynamicResource Industrial90.TextBrush}" />

            <TextBlock Grid.Column="2" Text="{TemplateBinding CountText}"
                       FontFamily="Cascadia Mono,Consolas,monospace"
                       FontSize="15" FontWeight="Bold"
                       Foreground="{TemplateBinding StatusBrush}" />

            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{TemplateBinding StatusText}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{TemplateBinding StatusBrush}" />

            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{TemplateBinding Reason}"
                       TextWrapping="Wrap" FontSize="9"
                       Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
          </Grid>
        </Border>
      </Border>
    </ControlTemplate>
  </Setter>
</ControlTheme>

  <ControlTheme x:Key="{x:Type controls:IndustrialRockerSwitch}"
              TargetType="controls:IndustrialRockerSwitch">
      <Setter Property="Cursor" Value="Hand" />
<Setter Property="Focusable" Value="True" />
  <Setter Property="FocusAdorner" Value="{StaticResource Industrial90.FocusAdorner}" />
<Setter Property="MinWidth" Value="220" />
  <Setter Property="MinHeight" Value="310" />
  <Setter Property="Background" Value="Transparent" />
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="{TemplateBinding Background}" Padding="6">
        <StackPanel Spacing="8">
          <TextBlock Text="{TemplateBinding Title}" HorizontalAlignment="Center"
                     FontSize="12" FontWeight="Bold"
                     Foreground="{DynamicResource Industrial90.TextBrush}" />
          <controls:RockerSwitchDial Width="118" Height="168"
                                     HorizontalAlignment="Center"
                                     IsOn="{TemplateBinding IsOn}"
                                     IsInterlocked="{TemplateBinding IsInterlocked}" />
          <TextBlock Text="{TemplateBinding StateText}"
                     HorizontalAlignment="Center" Margin="0,2,0,0"
                     FontSize="17" FontWeight="Bold" Foreground="#F1F1DF" />
          <TextBlock x:Name="InterlockStatusText" Text="{TemplateBinding StatusText}"
                     HorizontalAlignment="Center" FontSize="9"
                     Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
        </StackPanel>
      </Border>
    </ControlTemplate>
  </Setter>

  <Style Selector="^:interlocked">
    <Setter Property="Opacity" Value="0.78" />
  </Style>

  <Style Selector="^:interlocked /template/ TextBlock#InterlockStatusText">
    <Setter Property="Foreground" Value="#F2DD4B" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
</ControlTheme>

  
<ControlTheme x:Key="{x:Type controls:SignalQualityIndicator}"
              TargetType="controls:SignalQualityIndicator">
  <Setter Property="MinWidth" Value="250" />
  <Setter Property="MinHeight" Value="88" />
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="#191C1E"
              BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
              BorderThickness="3"
              CornerRadius="3"
              Padding="10">
        <Grid ColumnDefinitions="Auto,*,Auto"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="14"
              RowSpacing="3">
          <Grid Grid.RowSpan="2"
                Width="42"
                Height="42"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Ellipse Fill="#101214"
                     Stroke="#2C3135"
                     StrokeThickness="3" />
            <Ellipse Margin="5"
                     Fill="#1A1F22"
                     Stroke="#8D9398"
                     StrokeThickness="1.5" />
            <Ellipse Margin="9"
                     Fill="{TemplateBinding QualityBrush}"
                     Stroke="#0E1011"
                     StrokeThickness="1.5" />
          </Grid>

          <TextBlock Grid.Column="1"
                     Text="{TemplateBinding SignalName}"
                     FontSize="11"
                     FontWeight="Bold"
                     Foreground="{DynamicResource Industrial90.TextBrush}" />

          <TextBlock Grid.Column="2"
                     Text="{TemplateBinding QualityText}"
                     FontSize="11"
                     FontWeight="Bold"
                     Foreground="{TemplateBinding QualityBrush}" />

          <TextBlock Grid.Row="1"
                     Grid.Column="1"
                     Grid.ColumnSpan="2"
                     Text="{TemplateBinding Source}"
                     FontSize="9"
                     Foreground="{DynamicResource Industrial90.MutedTextBrush}" />
        </Grid>
      </Border>
    </ControlTemplate>
  </Setter>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:IndustrialScreen}"
              TargetType="controls:IndustrialScreen">
  <Setter Property="Padding" Value="12" />
  <Setter Property="MinHeight" Value="180" />
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="#151819"
              BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
              BorderThickness="6"
              CornerRadius="5"
              Padding="3">
        <Border BorderBrush="{DynamicResource Industrial90.EdgeLightBrush}"
                BorderThickness="1"
                CornerRadius="2">
          <Grid RowDefinitions="Auto,*">
            <Border Padding="10,7"
                    Background="#202426"
                    BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
                    BorderThickness="0,0,0,2">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{TemplateBinding Title}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Industrial90.TextBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{TemplateBinding StatusText}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{TemplateBinding StatusBrush}" />
              </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Background="#080B0C">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              <Border IsHitTestVisible="False"
                      IsVisible="{TemplateBinding ShowScanlines}"
                      Background="#08FFFFFF" />
            </Grid>
          </Grid>
        </Border>
      </Border>
    </ControlTemplate>
  </Setter>
</ControlTheme>

  
<ControlTheme x:Key="{x:Type controls:BacklitAlarmIndicator}"
              TargetType="controls:BacklitAlarmIndicator">
  <Setter Property="MinWidth" Value="210" />
  <Setter Property="MinHeight" Value="82" />
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="#111315"
              BorderBrush="{DynamicResource Industrial90.EdgeDarkBrush}"
              BorderThickness="4"
              CornerRadius="3"
              Padding="4">
        <Border Background="#262B2E"
                BorderBrush="{DynamicResource Industrial90.EdgeLightBrush}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="4">
          <Border Background="{TemplateBinding DisplayBrush}"
                  Opacity="{TemplateBinding EffectiveOpacity}"
                  CornerRadius="2"
                  Padding="10,7">
            <Grid RowDefinitions="*,Auto">
              <StackPanel VerticalAlignment="Center"
                          Spacing="2">
                <TextBlock Text="{TemplateBinding Text}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="{TemplateBinding DisplayForegroundBrush}" />
                <TextBlock Text="{TemplateBinding SecondaryText}"
                           TextAlignment="Center"
                           FontSize="9"
                           Foreground="{TemplateBinding DisplayForegroundBrush}" />
              </StackPanel>

              <TextBlock Grid.Row="1"
                         Text="{TemplateBinding StateText}"
                         HorizontalAlignment="Center"
                         FontSize="8"
                         FontWeight="Bold"
                         Foreground="{TemplateBinding DisplayForegroundBrush}" />
            </Grid>
          </Border>
        </Border>
      </Border>
    </ControlTemplate>
  </Setter>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:SafetyPlacard}"
              TargetType="controls:SafetyPlacard">
  <Setter Property="MinWidth" Value="260" />
  <Setter Property="MinHeight" Value="150" />
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="{TemplateBinding BodyBrush}"
              BorderBrush="#111315"
              BorderThickness="4"
              CornerRadius="2">
        <Grid RowDefinitions="Auto,*">
          <Border Background="{TemplateBinding HeaderBrush}"
                  Padding="12,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Ellipse Width="8"
                       Height="8"
                       Fill="#858B8E"
                       VerticalAlignment="Center"
                       IsVisible="{TemplateBinding ShowFasteners}" />

              <TextBlock Grid.Column="1"
                         Text="{TemplateBinding Title}"
                         HorizontalAlignment="Center"
                         FontSize="15"
                         FontWeight="Bold"
                         Foreground="{TemplateBinding HeaderForegroundBrush}" />

              <Ellipse Grid.Column="2"
                       Width="8"
                       Height="8"
                       Fill="#858B8E"
                       VerticalAlignment="Center"
                       IsVisible="{TemplateBinding ShowFasteners}" />
            </Grid>
          </Border>

          <Grid Grid.Row="1"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="14"
                Margin="14,12">
            <Border Width="62"
                    Height="62"
                    Background="#F8F7EE"
                    BorderBrush="#111315"
                    BorderThickness="3"
                    CornerRadius="31">
              <TextBlock Text="{TemplateBinding IconGlyph}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="32"
                         FontWeight="Bold"
                         Foreground="#111315" />
            </Border>

            <TextBlock Grid.Column="1"
                       Text="{TemplateBinding Text}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#17191B" />
          </Grid>
        </Grid>
      </Border>
    </ControlTemplate>
  </Setter>
</ControlTheme>

<ControlTheme x:Key="{x:Type controls:BoltedDataPlate}"
              TargetType="controls:BoltedDataPlate">
  <Setter Property="MinWidth" Value="300" />
  <Setter Property="MinHeight" Value="180" />
  <Setter Property="Padding" Value="20" />
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="{TemplateBinding PlateBrush}"
              BorderBrush="{TemplateBinding PlateEdgeBrush}"
              BorderThickness="4"
              CornerRadius="3"
              Padding="5">
        <Grid>
          <Ellipse Width="9"
                   Height="9"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Fill="#858B8E"
                   Stroke="#17191B"
                   StrokeThickness="1"
                   IsVisible="{TemplateBinding ShowFasteners}" />
          <Ellipse Width="9"
                   Height="9"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Fill="#858B8E"
                   Stroke="#17191B"
                   StrokeThickness="1"
                   IsVisible="{TemplateBinding ShowFasteners}" />
          <Ellipse Width="9"
                   Height="9"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Fill="#858B8E"
                   Stroke="#17191B"
                   StrokeThickness="1"
                   IsVisible="{TemplateBinding ShowFasteners}" />
          <Ellipse Width="9"
                   Height="9"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Fill="#858B8E"
                   Stroke="#17191B"
                   StrokeThickness="1"
                   IsVisible="{TemplateBinding ShowFasteners}" />

          <Grid Margin="{TemplateBinding Padding}"
                RowDefinitions="Auto,Auto,*,Auto"
                RowSpacing="5">
            <TextBlock Text="{TemplateBinding Title}"
                       HorizontalAlignment="Center"
                       FontSize="15"
                       FontWeight="Bold"
                       Foreground="{TemplateBinding PlateForegroundBrush}" />

            <TextBlock Grid.Row="1"
                       Text="{TemplateBinding Subtitle}"
                       HorizontalAlignment="Center"
                       FontSize="10"
                       Foreground="{TemplateBinding PlateForegroundBrush}" />

            <ContentPresenter Grid.Row="2"
                              Margin="0,8"
                              Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

            <TextBlock Grid.Row="3"
                       Text="{TemplateBinding Identifier}"
                       HorizontalAlignment="Right"
                       FontFamily="Cascadia Mono,Consolas,monospace"
                       FontSize="9"
                       Foreground="{TemplateBinding PlateForegroundBrush}" />
          </Grid>
        </Grid>
      </Border>
    </ControlTemplate>
  </Setter>
</ControlTheme>

  
<ControlTheme x:Key="{x:Type controls:AlarmIndicatorPanel}"
              TargetType="controls:AlarmIndicatorPanel">
  <Setter Property="Template">
    <ControlTemplate>
      <Border Background="#454A4E"
              BorderBrush="#17191B"
              BorderThickness="5"
              CornerRadius="3"
              Padding="5">
        <Border BorderBrush="#969DA1"
                BorderThickness="1"
                CornerRadius="2">
          <Grid RowDefinitions="Auto,*">
            <Border Background="#292C2F"
                    BorderBrush="#17191B"
                    BorderThickness="0,0,0,2"
                    Padding="12,9">
              <Grid ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="9">
                <TextBlock Text="{TemplateBinding Title}"
                           FontSize="14"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Foreground="#E5E7DE" />

                <Grid Grid.Column="1"
                      Width="10"
                      Height="10"
                      IsVisible="{TemplateBinding ShowFasteners}">
                  <Ellipse Fill="#858B8E"
                           Stroke="#17191B"
                           StrokeThickness="1" />
                  <Border Height="1"
                          Width="5"
                          Background="#4B5052"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Column="2"
                      Width="10"
                      Height="10"
                      IsVisible="{TemplateBinding ShowFasteners}">
                  <Ellipse Fill="#858B8E"
                           Stroke="#17191B"
                           StrokeThickness="1" />
                  <Border Height="1"
                          Width="5"
                          Background="#4B5052"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
              </Grid>
            </Border>

            <Border Grid.Row="1"
                    Padding="{TemplateBinding PanelPadding}">
              <ItemsControl
                  ItemsSource="{Binding Indicators, RelativeSource={RelativeSource TemplatedParent}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid
                        Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType=controls:AlarmIndicatorPanel}}"
                        ColumnSpacing="{Binding HorizontalGap, RelativeSource={RelativeSource AncestorType=controls:AlarmIndicatorPanel}}"
                        RowSpacing="{Binding VerticalGap, RelativeSource={RelativeSource AncestorType=controls:AlarmIndicatorPanel}}" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </Border>
          </Grid>
        </Border>
      </Border>
    </ControlTemplate>
  </Setter>
</ControlTheme>

  </Styles.Resources>

  <Style Selector="controls|EngravedLabel[Variant=Red]">
      <Setter Property="Background" Value="{DynamicResource Industrial90.LabelRedBrush}" />
    </Style>

  <Style Selector="controls|EngravedLabel[Variant=Aluminum]">
      <Setter Property="Background" Value="{DynamicResource Industrial90.LabelAluminumBrush}" />
      <Setter Property="Foreground" Value="#17191B" />
    </Style>

  <Style Selector="controls|IlluminatedPushButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource Industrial90.PanelLightBrush}" />
    </Style>

  <Style Selector="controls|IlluminatedPushButton:pressed">
      <Setter Property="Padding" Value="11,12,9,8" />
      <Setter Property="Background" Value="{DynamicResource Industrial90.PanelDarkBrush}" />
    </Style>


  <Style Selector="controls|IlluminatedPushButton:interlocked">
      <Setter Property="Background" Value="#2B2920" />
      <Setter Property="BorderBrush" Value="#D4B936" />
      <Setter Property="CaptionForeground" Value="#F2DD4B" />
      <Setter Property="Opacity" Value="0.78" />
    </Style>

  <Style Selector="controls|IlluminatedPushButton:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
</Styles>
