diff --git a/tests/NuclearReactorSimulator.App.Tests/PrimaryPumpPanelTests.cs b/tests/NuclearReactorSimulator.App.Tests/PrimaryPumpPanelTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..47544f97a4784a4a439f155ce16be071d0baae3e
--- /dev/null
+++ b/tests/NuclearReactorSimulator.App.Tests/PrimaryPumpPanelTests.cs
@@ -0,0 +1,189 @@
+using IndustrialControls.Avalonia.Controls;
+using NuclearReactorSimulator.App.Presentation;
+using NuclearReactorSimulator.App.ViewModels;
+using NuclearReactorSimulator.Application;
+using NuclearReactorSimulator.Application.ControlRoom;
+using NuclearReactorSimulator.Application.ControlRoom.Hmi;
+using Xunit;
+
+namespace NuclearReactorSimulator.App.Tests;
+
+public sealed class PrimaryPumpPanelTests
+{
+    [Fact]
+    public void CommandsWaitForPublishedFeedback_AndRefreshNeverDispatches()
+    {
+        var starts = 0;
+        var stops = 0;
+        var panel = new PrimaryPumpPanelViewModel(() => starts++, () => stops++);
+        panel.Update(Pump("pump-1", running: false), ControlRoomRunState.Paused);
+        panel.StartCommand.Execute(null);
+        Assert.Equal(1, starts);
+        Assert.True(panel.IsStopped);
+        Assert.False(panel.IsRunning);
+        panel.Update(Pump("pump-1", running: true), ControlRoomRunState.Running);
+        Assert.True(panel.IsRunning);
+        Assert.False(panel.CanStart);
+        Assert.True(panel.CanStop);
+        panel.StopCommand.Execute(null);
+        Assert.True(panel.IsRunning);
+        panel.Update(Pump("pump-1", running: false), ControlRoomRunState.Running);
+        Assert.True(panel.IsStopped);
+        Assert.Equal(1, starts);
+        Assert.Equal(1, stops);
+    }
+
+    [Theory]
+    [InlineData(false, ControlRoomRunState.Paused)]
+    [InlineData(true, ControlRoomRunState.ShellOnly)]
+    public void UnavailableCommandsFailClosed_EvenWhenExecutedDirectly(bool commandable, ControlRoomRunState state)
+    {
+        var commands = 0;
+        var panel = new PrimaryPumpPanelViewModel(() => commands++, () => commands++);
+        panel.Update(Pump("pump-1", commandable: commandable), state);
+        Assert.False(panel.StartCommand.CanExecute(null));
+        Assert.False(panel.StopCommand.CanExecute(null));
+        panel.StartCommand.Execute(null);
+        panel.StopCommand.Execute(null);
+        Assert.Equal(0, commands);
+    }
+
+    [Fact]
+    public void RemovingPumpClearsFeedbackMeasurementsAndCommands()
+    {
+        var panel = new PrimaryPumpPanelViewModel(() => { }, () => { });
+        panel.Update(Pump("pump-1", running: true), ControlRoomRunState.Running);
+        panel.Update(null, ControlRoomRunState.Paused);
+        Assert.False(panel.IsRunning);
+        Assert.False(panel.IsStopped);
+        Assert.False(panel.CanStart);
+        Assert.False(panel.CanStop);
+        Assert.Equal("UNAVAILABLE", panel.OperatingText);
+        Assert.All(panel.Measurements, value => Assert.Equal("—", value.Current.ValueText));
+    }
+
+    [Fact]
+    public void MeasurementRowsStayStableAndUnchangedReadingsDoNotNotify()
+    {
+        var panel = new PrimaryPumpPanelViewModel(() => { }, () => { });
+        var rows = panel.Measurements;
+        var first = rows[0];
+        var changes = 0;
+        first.PropertyChanged += (_, _) => changes++;
+        panel.Update(Pump("pump-1"), ControlRoomRunState.Paused);
+        Assert.Equal(1, changes);
+        panel.Update(Pump("pump-1"), ControlRoomRunState.Running);
+        Assert.Same(rows, panel.Measurements);
+        Assert.Same(first, panel.Measurements[0]);
+        Assert.Equal(1, changes);
+        panel.Update(null, ControlRoomRunState.Paused);
+        Assert.Equal(2, changes);
+        Assert.Equal("—", first.Current.ValueText);
+    }
+
+    [Theory]
+    [InlineData(null, ControlRoomInstrumentQuality.Good, ControlRoomVisualState.Normal)]
+    [InlineData(double.NaN, ControlRoomInstrumentQuality.Good, ControlRoomVisualState.Normal)]
+    [InlineData(double.PositiveInfinity, ControlRoomInstrumentQuality.Good, ControlRoomVisualState.Normal)]
+    [InlineData(12d, ControlRoomInstrumentQuality.Unavailable, ControlRoomVisualState.Normal)]
+    [InlineData(12d, ControlRoomInstrumentQuality.Good, ControlRoomVisualState.Unavailable)]
+    public void MissingOrInvalidReadingsNeverBecomeValidZero(double? numeric, ControlRoomInstrumentQuality quality, ControlRoomVisualState state)
+    {
+        var value = IndustrialInstrumentPresentation.From("FLOW",
+            new ControlRoomValueSnapshot("12", "kg/s", numeric, state) { Quality = quality });
+        Assert.Equal("—", value.ValueText);
+        Assert.Equal(SignalQuality.Unavailable, value.Quality);
+        Assert.Equal("UNAVAILABLE", value.StateText);
+        Assert.Equal("kg/s", value.Unit);
+    }
+
+    [Fact]
+    public void ReadoutPreservesAuthoritativeFormattingProvenanceQualityAndTrip()
+    {
+        var value = IndustrialInstrumentPresentation.From("FLOW",
+            new ControlRoomValueSnapshot("1.234,50", "kg/s", 1234.5, ControlRoomVisualState.Trip)
+            {
+                Quality = ControlRoomInstrumentQuality.Suspect,
+                Provenance = ControlRoomInstrumentProvenance.Measured,
+            });
+        Assert.Equal("1.234,50", value.ValueText);
+        Assert.Equal("MEASURED", value.Source);
+        Assert.Equal(SignalQuality.Uncertain, value.Quality);
+        Assert.Equal("TRIP", value.StateText);
+        Assert.Equal("SCALE —", value.ScaleText);
+    }
+
+    [Fact]
+    public void OffScaleReadoutPreservesValueAndCanonicalScaleDescription()
+    {
+        var snapshot = new ControlRoomValueSnapshot("110", "rpm", 110, ControlRoomVisualState.Warning)
+        {
+            InstrumentScale = new ControlRoomInstrumentScaleSnapshot(0, 100, setpoint: 50),
+        };
+        var value = IndustrialInstrumentPresentation.From("SPEED", snapshot);
+        Assert.Equal("110", value.ValueText);
+        Assert.Contains(snapshot.ScaleSemanticsText, value.ScaleText);
+        Assert.Contains(snapshot.ScaleStatusText, value.ScaleText);
+    }
+
+    [Fact]
+    public void MainWindowSelectionAndSnapshotRefreshUseCanonicalPumpTarget()
+    {
+        var dispatcher = new RecordingDispatcher();
+        var source = new InMemoryControlRoomSnapshotSource(Snapshot(Pump("pump-1"), Pump("pump-2")));
+        var vm = new MainWindowViewModel(new ApplicationDescriptor("NRS", "TEST", "TEST"), source, dispatcher);
+        vm.SelectedPumpIndex = 1;
+        Assert.Empty(dispatcher.Commands);
+        Assert.Equal("pump-2", vm.PumpPilot.PumpId);
+        vm.PumpPilot.StartCommand.Execute(null);
+        var command = Assert.Single(dispatcher.Commands);
+        Assert.Equal(ControlRoomCommandKind.MainCirculationPumpStart, command.Kind);
+        Assert.Equal(ControlRoomCommandTargetKind.Pump, command.TargetKind);
+        Assert.Equal("pump-2", command.TargetId);
+        Assert.False(vm.PumpPilot.IsRunning);
+        source.Publish(Snapshot(Pump("pump-2", running: true)));
+        Assert.Equal("pump-2", vm.PumpPilot.PumpId);
