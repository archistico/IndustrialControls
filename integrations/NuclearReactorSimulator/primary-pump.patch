diff --git a/src/NuclearReactorSimulator.App/ViewModels/PrimaryPumpPanelViewModel.cs b/src/NuclearReactorSimulator.App/ViewModels/PrimaryPumpPanelViewModel.cs
new file mode 100644
index 0000000000000000000000000000000000000000..2ff05c781ffb9f89eaa20d2e12e4172cee0585ca
--- /dev/null
+++ b/src/NuclearReactorSimulator.App/ViewModels/PrimaryPumpPanelViewModel.cs
@@ -0,0 +1,76 @@
+using System.ComponentModel;
+using System.Windows.Input;
+using NuclearReactorSimulator.App.Presentation;
+using NuclearReactorSimulator.Application.ControlRoom;
+
+namespace NuclearReactorSimulator.App.ViewModels;
+
+/// <summary>Snapshot-driven pump feedback. Only explicit commands invoke the existing application dispatch path.</summary>
+public sealed class PrimaryPumpPanelViewModel : INotifyPropertyChanged
+{
+    private readonly PumpCommand _startCommand;
+    private readonly PumpCommand _stopCommand;
+    private PrimaryCircuitPumpPresentationSnapshot? _pump;
+    private ControlRoomRunState _runState;
+
+    public PrimaryPumpPanelViewModel(Action start, Action stop)
+    {
+        _startCommand = new PumpCommand(start, () => CanStart);
+        _stopCommand = new PumpCommand(stop, () => CanStop);
+        Update(null, ControlRoomRunState.ShellOnly);
+    }
+
+    public event PropertyChangedEventHandler? PropertyChanged;
+
+    public string PumpId => _pump?.PumpId ?? "NO PUMP SELECTED";
+    public string LoopId => _pump?.LoopId ?? "—";
+    public bool HasPump => _pump is not null && _runState != ControlRoomRunState.ShellOnly;
+    public bool IsRunning => HasPump && _pump!.IsRunning;
+    public bool IsStopped => HasPump && !_pump!.IsRunning;
+    public bool CanStart => HasPump && _pump!.IsOperatorCommandable && !IsRunning;
+    public bool CanStop => HasPump && _pump!.IsOperatorCommandable && IsRunning;
+    public string OperatingText => !HasPump ? "UNAVAILABLE" : _pump!.OperatingText;
+    public string StartInterlockReason => !HasPump ? "NO PUMP AVAILABLE"
+        : !_pump!.IsOperatorCommandable ? "OPERATOR CONTROL UNAVAILABLE" : "PUMP ALREADY RUNNING";
+    public string StopInterlockReason => !HasPump ? "NO PUMP AVAILABLE"
+        : !_pump!.IsOperatorCommandable ? "OPERATOR CONTROL UNAVAILABLE" : "PUMP ALREADY STOPPED";
+    public ICommand StartCommand => _startCommand;
+    public ICommand StopCommand => _stopCommand;
+    public IReadOnlyList<IndustrialInstrumentReadoutViewModel> Measurements { get; } =
+        Array.AsReadOnly(new[] { new IndustrialInstrumentReadoutViewModel("SPEED"),
+            new IndustrialInstrumentReadoutViewModel("MASS FLOW"),
+            new IndustrialInstrumentReadoutViewModel("PRESSURE BOOST") });
+
+    public void Update(PrimaryCircuitPumpPresentationSnapshot? pump, ControlRoomRunState runState)
+    {
+        _pump = pump;
+        _runState = runState;
+        var unavailable = ControlRoomValueSnapshot.Unavailable();
+        Measurements[0].Update(HasPump ? pump!.Speed : unavailable);
+        Measurements[1].Update(HasPump ? pump!.MassFlow : unavailable);
+        Measurements[2].Update(HasPump ? pump!.PressureBoost : unavailable);
+        foreach (var name in new[] { nameof(PumpId), nameof(LoopId), nameof(HasPump), nameof(IsRunning),
+            nameof(IsStopped), nameof(CanStart), nameof(CanStop), nameof(OperatingText),
+            nameof(StartInterlockReason), nameof(StopInterlockReason) })
+        {
+            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(name));
+        }
+        _startCommand.NotifyCanExecuteChanged();
+        _stopCommand.NotifyCanExecuteChanged();
+    }
+
+    private sealed class PumpCommand(Action execute, Func<bool> canExecute) : ICommand
+    {
+        private readonly Action _execute = execute ?? throw new ArgumentNullException(nameof(execute));
+        public event EventHandler? CanExecuteChanged;
+        public bool CanExecute(object? parameter) => canExecute();
+        public void Execute(object? parameter)
+        {
+            if (CanExecute(parameter))
+            {
+                _execute();
+            }
+        }
+        public void NotifyCanExecuteChanged() => CanExecuteChanged?.Invoke(this, EventArgs.Empty);
+    }
+}
