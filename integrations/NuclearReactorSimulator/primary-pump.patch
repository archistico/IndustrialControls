@@ -0,0 +1,65 @@
+using System.Globalization;
+using System.ComponentModel;
+using IndustrialControls.Avalonia.Controls;
+using NuclearReactorSimulator.Application.ControlRoom;
+using NuclearReactorSimulator.Application.ControlRoom.Hmi;
+
+namespace NuclearReactorSimulator.App.Presentation;
+
+/// <summary>Maps published instrument semantics without calculating process state or inventing scale bands.</summary>
+public sealed record IndustrialInstrumentPresentation(
+    string Title,
+    string ValueText,
+    string Unit,
+    SignalQuality Quality,
+    string Source,
+    string StateText,
+    string ScaleText)
+{
+    public static IndustrialInstrumentPresentation From(string title, ControlRoomValueSnapshot snapshot)
+    {
+        ArgumentNullException.ThrowIfNull(snapshot);
+        var available = snapshot.NumericValue is { } value && double.IsFinite(value)
+            && snapshot.Quality != ControlRoomInstrumentQuality.Unavailable
+            && snapshot.State != ControlRoomVisualState.Unavailable;
+        var quality = !available ? SignalQuality.Unavailable : snapshot.Quality switch
+        {
+            ControlRoomInstrumentQuality.Good => SignalQuality.Good,
+            ControlRoomInstrumentQuality.Suspect => SignalQuality.Uncertain,
+            _ => SignalQuality.Unavailable,
+        };
+        var scale = snapshot.InstrumentScale;
+        var scaleText = scale is null ? "SCALE —" : string.Concat(
+            scale.Minimum.ToString("0.###", CultureInfo.InvariantCulture), "–",
+            scale.Maximum.ToString("0.###", CultureInfo.InvariantCulture), " ", snapshot.Unit,
+            " · ", snapshot.ScaleSemanticsText,
+            snapshot.IsOffScale ? " · " + snapshot.ScaleStatusText : string.Empty);
+        return new IndustrialInstrumentPresentation(
+            title,
+            available ? snapshot.ValueText : "—",
+            snapshot.Unit,
+            quality,
+            snapshot.ProvenanceText,
+            available ? snapshot.State.ToString().ToUpperInvariant() : "UNAVAILABLE",
+            scaleText);
+    }
+}
+
+/// <summary>Keeps each instrument and its visual tree stable across published snapshots.</summary>
+public sealed class IndustrialInstrumentReadoutViewModel(string title) : INotifyPropertyChanged
+{
+    public event PropertyChangedEventHandler? PropertyChanged;
+    public IndustrialInstrumentPresentation Current { get; private set; } =
+        IndustrialInstrumentPresentation.From(title, ControlRoomValueSnapshot.Unavailable());
+
+    public void Update(ControlRoomValueSnapshot snapshot)
+    {
+        var next = IndustrialInstrumentPresentation.From(title, snapshot);
+        if (next == Current)
+        {
+            return;
+        }
+        Current = next;
+        PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(nameof(Current)));
+    }
+}
